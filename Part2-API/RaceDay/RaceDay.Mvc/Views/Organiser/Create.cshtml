@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-5" style="max-width: 700px;">

    <h2>Create a RaceDay Event</h2>
    <p class="text-muted">Enter the details of your sporting event.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label class="form-label">Event Name</label>
            <input type="text" name="name" class="form-control"
                   maxlength="100" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control"
                      maxlength="500"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Event Date</label>
            <input type="date" name="eventDate" class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Location</label>
            <input type="text" name="location" class="form-control"
                   maxlength="100" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Distance (KM)</label>
            <input type="number" name="distanceKm" class="form-control"
                   min="0.1" max="1000" step="0.1" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Event Type</label>
            <select name="eventType" class="form-select" required>
                <option value="">Select event type</option>
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success">
            Create Event
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>
